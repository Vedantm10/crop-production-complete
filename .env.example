# AgriStat India — Environment Configuration Example

# Frontend (Vercel / Local)
# Set in frontend/.env.local or Vercel dashboard:
NEXT_PUBLIC_ANALYTICS_API_URL=http://127.0.0.1:8000
# Production: NEXT_PUBLIC_ANALYTICS_API_URL=https://agristat-india-api.onrender.com

# Backend (Render / Local)
# Optional override for dataset location:
# DATA_PATH=data/crop_production_1997_2025.csv
# Optional CORS origins (comma-separated):
# ALLOWED_ORIGINS=https://crop-production-complete-kd2sxmq5m-vedantmore077-9813.vercel.app,http://localhost:3000
